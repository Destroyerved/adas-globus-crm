// ADAS CRM — Canonical Prisma Schema (PRD §7.2 & §7.4)
// Partial unique indexes, trigram GIN indexes, check constraints, and
// append-only triggers/grants live in:
//   prisma/migrations/0001_initial_schema/migration.sql
//   prisma/migrations/0003_lists_editing_reference/migration.sql (keyset, trigram and
//   partial indexes for lists and reminders; tasks, notes, notifications and
//   pipeline_stages columns; system roles, pipelines and reference lists)
//   prisma/migrations/0004_admin_dashboard/migration.sql (versions on users, teams, settings
//   and stages; pipeline_stages.is_trial; stage IDs on deal_stage_history; audit-log,
//   SLA, activity and dashboard indexes)
//   prisma/migrations/0005_worker/migration.sql (tasks.sla_warned_at,
//   outbox_events.available_at, partial indexes for the worker's sweeps; the pgboss schema
//   is installed by `pnpm db:migrate`, ADR 0006)
//   prisma/migrations/0006_break_glass/migration.sql (local_credentials and its grant)
//   prisma/migrations/0007_imports/migration.sql (files, import tables and their check
//   constraints, partial indexes and grants; source and import batch on companies and
//   contacts; record_history.via; the open-pair unique index on duplicate_candidates; ADR 0008)
//   prisma/migrations/0008_merges/migration.sql (merge_logs undo columns and indexes; the
//   'stopped_merged' enrollment status; duplicate pair and foreign-key indexes; ADR 0009)
//   prisma/migrations/0009_exports/migration.sql (exports: status checks, the worker's partial
//   indexes and grants; ADR 0010)
//   prisma/migrations/0010_list_indexes/migration.sql (partial and expression indexes for the
//   list sorts: name, last contacted, created, status, score, value, close date, due and
//   completed; ADR 0011)
//   prisma/migrations/0011_compliance_and_privacy/migration.sql (suppression lift columns,
//   privacy_erasure immutability trigger, consent purpose/revocation columns; ADR 0013)
//   prisma/migrations/0012_intake_routing_and_tokens/migration.sql (inquiries, routing_rules,
//   public_rate_events, consent_records.inquiry_id, unsubscribe_tokens.token_sha256; ADR 0014)
//   prisma/migrations/0013_api_tokens_and_security/migration.sql (api_tokens scope_level,
//   capabilities, expires_at, last_used_ip, active-hash index; ADR 0015)
//   prisma/migrations/0014_saved_views_and_bulk_jobs/migration.sql (saved_views team_id,
//   params_json, sort_spec, columns_json, version, updated_at; bulk_jobs table and indexes)
//   prisma/migrations/0015_custom_fields_scoring_and_conversion/migration.sql (custom_field_definitions
//   money/url/archive/order, leads/deals custom_fields JSONB GIN indexes, scoring_rules defaults)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Team {
  id        String   @id
  name      String   @unique
  market    String   @default("US")
  version   Int      @default(1) // migration 0004
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6) // migration 0004

  @@map("teams")
}

model Role {
  id          String   @id
  name        String   @unique
  description String
  isSystem    Boolean  @default(true) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("roles")
}

model User {
  id            String   @id
  email         String   @unique
  name          String
  roleId        String   @map("role_id")
  teamId        String?  @map("team_id")
  marketFocus   String   @default("US") @map("market_focus")
  status        String   @default("active")
  isBreakGlass  Boolean  @default(false) @map("is_break_glass")
  // Deprecated (cleared in 0006, to be dropped): credentials live in local_credentials.
  passwordHash  String?  @map("password_hash")
  totpSecret    String?  @map("totp_secret")
  dailySendCap  Int      @default(50) @map("daily_send_cap")
  timezone      String   @default("Asia/Kolkata") // migration 0003
  version       Int      @default(1) // migration 0004
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([teamId])
  @@index([roleId])
  @@map("users")
}

// Emergency admin credentials (PRD 6.6, 7.2): at most two accounts. Migration 0006.
model LocalCredential {
  userId               String    @id @map("user_id")
  passwordHash         String    @map("password_hash") // Argon2id
  totpSecretCiphertext String    @map("totp_secret_ciphertext") // AES-256-GCM, never plain
  totpLastStep         BigInt?   @map("totp_last_step")
  failedAttempts       Int       @default(0) @map("failed_attempts")
  lockedUntil          DateTime? @map("locked_until") @db.Timestamptz(6)
  lastFailedAt         DateTime? @map("last_failed_at") @db.Timestamptz(6)
  lastUsedAt           DateTime? @map("last_used_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("local_credentials")
}

// Append-only table protected by REVOKE UPDATE, DELETE and trg_audit_logs_immutable
// in migrations/0001_initial_schema/migration.sql (PRD §9 & §7.4)
model AuditLog {
  id          String   @id
  actorUserId String?  @map("actor_user_id")
  actorEmail  String?  @map("actor_email")
  action      String
  entityType  String   @map("entity_type")
  entityId    String?  @map("entity_id")
  metadata    Json     @default("{}")
  ipAddress   String?  @map("ip_address")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Partial unique index idx_companies_domain_active and trigram GIN index
// idx_companies_name_trgm defined in migrations/0001_initial_schema/migration.sql
model Company {
  id                    String    @id
  name                  String
  domain                String?
  website               String?
  firmType              String    @default("CPA firm") @map("firm_type")
  market                String    @default("US")
  stateProvince         String?   @map("state_province")
  city                  String?
  timezone              String    @default("America/New_York")
  staffBand             String    @default("11–20") @map("staff_band")
  accountStatus         String    @default("prospect") @map("account_status")
  ownerUserId           String    @map("owner_user_id")
  teamId                String?   @map("team_id")
  accountingSoftware    Json      @default("[]") @map("accounting_software")
  servicesNeeded        Json      @default("[]") @map("services_needed")
  estimatedRevenueMinor BigInt    @default(0) @map("estimated_revenue_minor")
  currency              String    @default("USD")
  customFields          Json      @default("{}") @map("custom_fields")
  version               Int       @default(1)
  lastContactedAt DateTime? @map("last_contacted_at") @db.Timestamptz(6) // migration 0003
  source                String? // migration 0007
  importBatchId         String?   @map("import_batch_id") // migration 0007, partial index
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([ownerUserId])
  @@index([teamId])
  @@index([market])
  @@map("companies")
}

// Partial unique index idx_contacts_primary_email_active and trigram GIN index
// idx_contacts_full_name_trgm defined in migrations/0001_initial_schema/migration.sql
model Contact {
  id                      String    @id
  companyId               String?   @map("company_id")
  firstName               String    @map("first_name")
  lastName                String    @map("last_name")
  fullName                String    @map("full_name")
  title                   String    @default("Partner")
  jobFunction             String    @default("Partner / Principal") @map("job_function")
  seniority               String    @default("Partner")
  primaryEmail            String    @map("primary_email")
  phoneE164               String?   @map("phone_e164")
  market                  String    @default("US")
  timezone                String    @default("America/New_York")
  ownerUserId             String    @map("owner_user_id")
  teamId                  String?   @map("team_id")
  doNotContact            Boolean   @default(false) @map("do_not_contact")
  emailVerificationStatus String    @default("unknown") @map("email_verification_status")
  hardBouncedAt           DateTime? @map("hard_bounced_at") @db.Timestamptz(6)
  apolloPersonId          String?   @map("apollo_person_id")
  leadScore               Int       @default(0) @map("lead_score")
  leadScoreBreakdown      Json      @default("[]") @map("lead_score_breakdown")
  customFields            Json      @default("{}") @map("custom_fields")
  version                 Int       @default(1)
  lastContactedAt DateTime? @map("last_contacted_at") @db.Timestamptz(6) // migration 0003
  source                  String? // migration 0007
  importBatchId           String?   @map("import_batch_id") // migration 0007, partial index
  deletedAt               DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt               DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([companyId])
  @@index([ownerUserId])
  @@index([teamId])
  @@map("contacts")
}

model Lead {
  id                     String    @id
  firstName              String    @map("first_name")
  lastName               String    @map("last_name")
  fullName               String    @map("full_name")
  email                  String
  phoneE164              String?   @map("phone_e164")
  firmName               String?   @map("firm_name")
  domain                 String?
  website                String?
  title                  String    @default("Partner")
  market                 String    @default("US")
  stateProvince          String?   @map("state_province")
  staffBand              String    @default("11–20") @map("staff_band")
  source                 String    @default("Manual entry")
  status                 String    @default("New")
  statusCategory         String    @default("open") @map("status_category")
  disqualificationReason String?   @map("disqualification_reason")
  servicesNeeded         Json      @default("[]") @map("services_needed")
  softwareStack          Json      @default("[]") @map("software_stack")
  ownerUserId            String    @map("owner_user_id")
  teamId                 String?   @map("team_id")
  companyId              String?   @map("company_id")
  contactId              String?   @map("contact_id")
  convertedDealId        String?   @map("converted_deal_id")
  convertedAt            DateTime? @map("converted_at") @db.Timestamptz(6)
  leadScore              Int       @default(0) @map("lead_score")
  leadScoreBreakdown     Json      @default("[]") @map("lead_score_breakdown")
  customFields           Json      @default("{}") @map("custom_fields")
  utmSource              String?   @map("utm_source")
  utmMedium              String?   @map("utm_medium")
  utmCampaign            String?   @map("utm_campaign")
  version                Int       @default(1)
  lastContactedAt DateTime? @map("last_contacted_at") @db.Timestamptz(6) // migration 0003
  deletedAt              DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt              DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([email])
  @@index([ownerUserId])
  @@index([teamId])
  @@index([status])
  @@map("leads")
}

model Deal {
  id                 String    @id
  pipelineId         String    @map("pipeline_id")
  stageId            String    @map("stage_id")
  stageName          String    @map("stage_name")
  stageCategory      String    @default("open") @map("stage_category")
  companyId          String    @map("company_id")
  primaryContactId   String?   @map("primary_contact_id")
  name               String
  monthlyValueMinor  BigInt    @map("monthly_value_minor")
  annualValueMinor   BigInt    @map("annual_value_minor")
  currency           String    @default("USD")
  fteCount           Float     @default(1) @map("fte_count")
  engagementModel    String    @default("Full-time") @map("engagement_model")
  services           Json      @default("[]")
  customFields       Json      @default("{}") @map("custom_fields")
  probability        Int       @default(10)
  expectedCloseDate  String?   @map("expected_close_date")
  trialStartedAt     DateTime? @map("trial_started_at") @db.Timestamptz(6)
  trialEndsAt        DateTime? @map("trial_ends_at") @db.Timestamptz(6)
  trialCandidateRole String?   @map("trial_candidate_role")
  trialPassed        Boolean?  @map("trial_passed")
  contractStartDate  String?   @map("contract_start_date")
  lostReason         String?   @map("lost_reason")
  lostNotes          String?   @map("lost_notes")
  wonAt              DateTime? @map("won_at") @db.Timestamptz(6)
  lostAt             DateTime? @map("lost_at") @db.Timestamptz(6)
  ownerUserId        String    @map("owner_user_id")
  teamId             String?   @map("team_id")
  version            Int       @default(1)
  // Added in migration 0003 (term_months and one_time_value_minor have CHECK constraints there)
  termMonths           Int       @default(12) @map("term_months")
  oneTimeValueMinor    BigInt    @default(0) @map("one_time_value_minor")
  probabilityOverride  Boolean   @default(false) @map("probability_override")
  closedAt             DateTime? @map("closed_at") @db.Timestamptz(6)
  fxRateScaledAtClose  BigInt?   @map("fx_rate_scaled_at_close")
  lastActivityAt       DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(6)
  idleFlaggedAt        DateTime? @map("idle_flagged_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([companyId])
  @@index([ownerUserId])
  @@index([teamId])
  @@index([stageName])
  @@map("deals")
}

// Non-deletable table protected by REVOKE DELETE and trg_suppressions_no_delete
// in migrations/0001_initial_schema/migration.sql (PRD §5.3 & §7.4).
// Lifting columns, permanent privacy_erasure CHECK + BEFORE UPDATE trigger, and
// keyset/trigram indexes are in migrations/0011_compliance_and_privacy/migration.sql.
model Suppression {
  id           String    @id
  email        String?   @unique
  emailSha256  String    @unique @map("email_sha256")
  reason       String
  source       String
  notes        String?
  actorUserId  String?   @map("actor_user_id")
  liftedAt     DateTime? @map("lifted_at") @db.Timestamptz(6)
  liftedBy     String?   @map("lifted_by")
  liftedReason String?   @map("lifted_reason")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("suppressions")
}

// Written ONLY by the send.message worker job after checkSendable() (PRD §5.1 & §7.2)
model MessageSend {
  id                   String    @id
  idempotencyKey       String    @unique @map("idempotency_key")
  channel              String
  recipientEmail       String    @map("recipient_email")
  contactId            String?   @map("contact_id")
  senderUserId         String?   @map("sender_user_id")
  sequenceEnrollmentId String?   @map("sequence_enrollment_id")
  campaignId           String?   @map("campaign_id")
  subject              String
  bodyText             String    @map("body_text")
  transportProvider    String    @map("transport_provider")
  providerMessageId    String?   @map("provider_message_id")
  status               String    @default("sent")
  complianceReasonCode String    @map("compliance_reason_code")
  sentAt               DateTime  @default(now()) @map("sent_at") @db.Timestamptz(6)
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([recipientEmail, sentAt])
  @@index([senderUserId, sentAt])
  @@map("message_sends")
}

// Imports (PRD 4.9, 6.11). Status and purpose checks, the "waiting" partial index and the
// grants are in migrations/0007_imports/migration.sql.
model File {
  id           String    @id
  storageKey   String    @unique @map("storage_key")
  originalName String    @map("original_name")
  contentType  String    @map("content_type")
  sizeBytes    BigInt    @map("size_bytes")
  sha256       String
  purpose      String // import | export
  ownerUserId  String    @map("owner_user_id")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)

  @@index([ownerUserId, createdAt(sort: Desc)])
  @@map("files")
}

// CSV exports of a list view (PRD 4.9, 6.9). Status checks, the worker's partial indexes and
// the grant are in migrations/0009_exports/migration.sql.
model Export {
  id            String    @id
  entity        String
  status        String    @default("queued")
  request       Json
  rowCount      Int       @default(0) @map("row_count")
  processedRows Int       @default(0) @map("processed_rows")
  background    Boolean   @default(false)
  fileId        String?   @map("file_id")
  heartbeatAt   DateTime? @map("heartbeat_at") @db.Timestamptz(6)
  failureReason String?   @map("failure_reason")
  requestedBy   String    @map("requested_by")
  teamId        String?   @map("team_id")
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  startedAt     DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(6)
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz(6)

  @@index([requestedBy, createdAt(sort: Desc)])
  @@index([teamId])
  @@index([fileId])
  @@map("exports")
}

model ImportBatch {
  id            String    @id
  entity        String    @default("contact")
  filename      String
  fileId        String    @map("file_id")
  status        String    @default("uploaded")
  columns       Json      @default("[]")
  rowCount      Int       @default(0) @map("row_count")
  sample        Json      @default("[]")
  mapping       Json      @default("{}")
  options       Json      @default("{}")
  dryRunCounts  Json?     @map("dry_run_counts")
  counts        Json      @default("{}")
  undoCounts    Json?     @map("undo_counts")
  processedRows Int       @default(0) @map("processed_rows")
  heartbeatAt   DateTime? @map("heartbeat_at") @db.Timestamptz(6)
  failureReason String?   @map("failure_reason")
  createdBy     String    @map("created_by")
  teamId        String?   @map("team_id")
  version       Int       @default(1)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  startedAt     DateTime? @map("started_at") @db.Timestamptz(6)
  finishedAt    DateTime? @map("finished_at") @db.Timestamptz(6)
  rolledBackAt  DateTime? @map("rolled_back_at") @db.Timestamptz(6)
  rolledBackBy  String?   @map("rolled_back_by")

  @@index([createdBy, createdAt(sort: Desc)])
  @@index([teamId, createdAt(sort: Desc)])
  @@index([fileId])
  @@map("import_batches")
}

model ImportRow {
  id               String   @id
  batchId          String   @map("batch_id")
  dryRun           Boolean  @map("dry_run")
  rowNumber        Int      @map("row_number")
  raw              Json
  status           String
  errors           Json     @default("[]")
  entityId         String?  @map("entity_id")
  entityVersion    Int?     @map("entity_version")
  before           Json?
  createdCompanyId String?  @map("created_company_id")
  probableOf       String?  @map("probable_of")
  undoStatus       String?  @map("undo_status")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([batchId, dryRun, rowNumber])
  @@index([batchId, dryRun, status, rowNumber])
  @@map("import_rows")
}

// Unique per user, entity and LOWER(name): expression index in migration 0007.
model ImportMappingTemplate {
  id        String   @id
  name      String
  entity    String
  mapping   Json
  createdBy String   @map("created_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("import_mapping_templates")
}

// Raw website inquiries, market routing rules and public rate-limit events (PRD 4.10, 4.17, 9).
// Check constraints, partial indexes and grants live in migrations/0012_intake_routing_and_tokens/migration.sql.
model Inquiry {
  id              String   @id
  dedupKey        String   @map("dedup_key")
  formType        String   @map("form_type")
  market          String
  emailSha256     String   @map("email_sha256")
  rawPayload      Json     @default("{}") @map("raw_payload")
  ipSha256        String?  @map("ip_sha256")
  userAgent       String?  @map("user_agent")
  pageUrl         String?  @map("page_url")
  deduplicated    Boolean  @default(false)
  leadId          String?  @map("lead_id")
  contactId       String?  @map("contact_id")
  companyId       String?  @map("company_id")
  consentRecordId String?  @map("consent_record_id")
  slaTaskId       String?  @map("sla_task_id")
  assignedUserId  String?  @map("assigned_user_id")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([dedupKey, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([emailSha256])
  @@map("inquiries")
}

model RoutingRule {
  market             String   @id
  mode               String   @default("round_robin")
  teamId             String?  @map("team_id")
  ownerUserId        String?  @map("owner_user_id")
  lastAssignedUserId String?  @map("last_assigned_user_id")
  version            Int      @default(1)
  updatedByUserId    String?  @map("updated_by_user_id")
  updatedAt          DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("routing_rules")
}

model PublicRateEvent {
  id        String   @id
  endpoint  String
  ipSha256  String   @map("ip_sha256")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([endpoint, ipSha256, createdAt(sort: Desc)])
  @@index([createdAt])
  @@map("public_rate_events")
}

// Service API tokens with explicit capability and scope ceiling (PRD 4.14, 9). Migration 0013.
model ApiToken {
  id              String    @id
  name            String
  tokenPrefix     String    @map("token_prefix")
  tokenSha256     String    @unique @map("token_sha256")
  scopes          Json      @default("[]")
  scopeLevel      String    @default("team") @map("scope_level")
  capabilities    Json      @default("[]")
  createdByUserId String    @map("created_by_user_id")
  expiresAt       DateTime? @map("expires_at") @db.Timestamptz(6)
  lastUsedAt      DateTime? @map("last_used_at") @db.Timestamptz(6)
  lastUsedIp      String?   @map("last_used_ip")
  lastAuditedAt   DateTime? @map("last_audited_at") @db.Timestamptz(6)
  revokedAt       DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdByUserId, createdAt(sort: Desc)])
  @@map("api_tokens")
}

// Saved views (PRD 4.8) and bulk action jobs (PRD 4.5, 6.7). Migration 0001 + 0014.
model SavedView {
  id          String   @id
  entityType  String   @map("entity_type")
  name        String
  ownerUserId String   @map("owner_user_id")
  teamId      String?  @map("team_id")
  isShared    Boolean  @default(false) @map("is_shared")
