model ApolloCreditLedger {
  id             String   @id
  action         String
  creditsUsed    Int      @map("credits_used")
  apolloPersonId String?  @map("apollo_person_id")
  apolloOrgId    String?  @map("apollo_org_id")
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  metadata       Json     @default("{}")
  actorUserId    String   @map("actor_user_id")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("apollo_credit_ledger")
}

model WebhookEndpoint {
  id               String    @id
  name             String
  description      String?
  targetUrl        String    @map("target_url")
  secretHmac       String    @default("") @map("secret_hmac")
  secretCiphertext String?   @map("secret_ciphertext")
  secretKeyVersion Int?      @map("secret_key_version")
  secretHint       String?   @map("secret_hint")
  eventTypes       Json      @default("[]") @map("event_types")
  active           Boolean   @default(true)
  lastStatusCode   Int?      @map("last_status_code")
  lastDeliveredAt  DateTime? @map("last_delivered_at") @db.Timestamptz(6)
  lastError        String?   @map("last_error")
  createdByUserId  String?   @map("created_by_user_id")
  version          Int       @default(1)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("webhook_endpoints")
}

model WebhookDelivery {
  id              String    @id
  endpointId      String    @map("endpoint_id")
  outboxEventId   String?   @map("outbox_event_id")
  eventType       String    @map("event_type")
  payload         Json
  status          String    @default("pending")
  attempts        Int       @default(0)
  lastStatusCode  Int?      @map("last_status_code")
  lastError       String?   @map("last_error")
  responseExcerpt String?   @map("response_excerpt")
  availableAt     DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  deliveredAt     DateTime? @map("delivered_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([endpointId, outboxEventId])
  @@index([endpointId, createdAt(sort: Desc)])
  @@map("webhook_deliveries")
}

model BookingEvent {
  id                   String    @id
  bookingAppointmentId String    @map("booking_appointment_id")
  eventType            String    @default("created") @map("event_type")
  serviceName          String    @map("service_name")
  startAt              DateTime  @map("start_at") @db.Timestamptz(6)
  endAt                DateTime? @map("end_at") @db.Timestamptz(6)
  customerEmailSha256  String    @map("customer_email_sha256")
  contactId            String?   @map("contact_id")
  activityId           String?   @map("activity_id")
  taskId               String?   @map("task_id")
  createdAt            DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([bookingAppointmentId, eventType])
  @@map("booking_events")
}

// Operational reliability: Outbox events, Background Worker Heartbeats & Backup Runs
// (PRD 6.9, 10.5, 10.6, 11 Phase 1). Migrations 0001, 0005 & 0022_worker_heartbeats_and_backups.
model OutboxEvent {
  id            String    @id
  eventType     String    @map("event_type")
  aggregateType String    @map("aggregate_type")
  aggregateId   String    @map("aggregate_id")
  payload       Json      @default("{}")
  status        String    @default("pending")
  attempts      Int       @default(0)
  retryCount    Int       @default(0) @map("retry_count") // migration 0022
  lastError     String?   @map("last_error")
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  processedAt   DateTime? @map("processed_at") @db.Timestamptz(6)

  @@index([status, createdAt(sort: Desc)])
  @@map("outbox_events")
}

model WorkerHeartbeat {
  workerId             String    @id @map("worker_id")
  hostname             String
  pid                  Int
  status               String    @default("running")
  activeJobs           Int       @default(0) @map("active_jobs")
  startedAt            DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  lastHeartbeatAt      DateTime  @default(now()) @map("last_heartbeat_at") @db.Timestamptz(6)
  lastJobName          String?   @map("last_job_name")
  lastJobAt            DateTime? @map("last_job_at") @db.Timestamptz(6)
  lastOutboxDispatchAt DateTime? @map("last_outbox_dispatch_at") @db.Timestamptz(6)
  stoppedAt            DateTime? @map("stopped_at") @db.Timestamptz(6)

  @@index([lastHeartbeatAt(sort: Desc)])
  @@map("worker_heartbeats")
}

model BackupRun {
  id             String    @id
  kind           String
  status         String
  artifactKey    String?   @map("artifact_key")
  sizeBytes      BigInt?   @map("size_bytes")
  checksumSha256 String?   @map("checksum_sha256")
  encrypted      Boolean   @default(true)
  offsiteSynced  Boolean   @default(false) @map("offsite_synced")
  startedAt      DateTime  @default(now()) @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime? @map("completed_at") @db.Timestamptz(6)
  durationMs     Int?      @map("duration_ms")
  errorCode      String?   @map("error_code")
  details        Json      @default("{}")

  @@index([kind, status, completedAt(sort: Desc)])
  @@map("backup_runs")
}


