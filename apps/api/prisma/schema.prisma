// Prisma schema for ADAS CRM (PRD §7)
// Partial, expression and trigram indexes, check constraints, generated columns,
// grants and triggers are added in hand-edited migration SQL (PRD §7.4, AGENTS.md §8).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
