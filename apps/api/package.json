{
  "name": "@adas/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/main.js",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "openapi:generate": "tsx src/openapi.ts && prettier --write openapi.json",
    "db:seed": "tsx scripts/seed.ts",
    "db:plans": "tsx scripts/query-plans.ts",
    "perf:load": "tsx scripts/load-test.ts",
    "backup:run": "tsx scripts/backup-cli.ts backup",
    "backup:drill": "tsx scripts/backup-cli.ts drill",
    "break-glass": "tsx scripts/break-glass.ts",
    "start:e2e": "tsx src/e2e-server.ts"
  },
  "dependencies": {
    "@adas/shared": "workspace:*",
    "@electric-sql/pglite": "^0.5.14",
    "@node-rs/argon2": "^2.2.2",
    "csv-parse": "^6.2.1",
    "exceljs": "^4.4.0",
    "openid-client": "^6.8.9",
    "pg": "^8.23.1",
    "pg-boss": "^10.4.2",
    "pino": "^9.6.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@adas/config": "workspace:*",
    "@types/node": "^22.13.5",
    "@types/pg": "^8.23.1",
    "prisma": "^6.4.1",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
