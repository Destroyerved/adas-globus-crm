            "description": "Redirect to Microsoft, or to the login page if not configured"
          }
        }
      }
    },
    "/auth/sso/callback": {
      "get": {
        "operationId": "finishMicrosoftSignIn",
        "summary": "Microsoft redirects here; validates the ID token and starts a session",
        "responses": {
