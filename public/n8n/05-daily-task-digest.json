{
  "name": "CRM · Daily task digest",
  "nodes": [
    {
      "parameters": {
        "content": "## Daily task digest\nEvery weekday at 08:30 (n8n timezone) pulls overdue and today's tasks and emails a summary through the CRM.\n\n**Setup**\n1. Create an API key in the CRM (Integrations → API keys).\n2. In n8n create a **Header Auth** credential named `CRM API key`: Name `Authorization`, Value `Bearer agp_…`.\n3. Select that credential on every *CRM* HTTP Request node.\n4. Set `crm_url` in the **CRM config** node.\n5. Set `digest_to` to the address that should receive the digest.",
        "width": 560,
        "height": 300
      },
      "id": "9eab16a2-dfc9-5a56-9b8f-53eb0d999a59",
      "name": "Note 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -330
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 8 * * 1-5"
            }
          ]
        }
      },
      "id": "bfb89700-f97b-5f3a-8555-e9247e193a58",
      "name": "Weekdays 08:30",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "d00a6c82-d7ce-5205-b452-eb8357f057c8",
              "name": "crm_url",
              "value": "http://localhost:3000",
              "type": "string"
            },
            {
              "id": "94b02e5a-e7f6-55f2-96c2-20894a78425b",
              "name": "digest_to",
              "value": "info@adasglobuspro.com",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "4f7d79e1-6e14-5e04-b251-9ccca852620e",
      "name": "CRM config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('CRM config').item.json.crm_url }}/api/tasks?view=overdue&limit=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "1c7f24de-6256-54de-88df-d5f48c38c5db",
      "name": "CRM: overdue",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('CRM config').item.json.crm_url }}/api/tasks?view=today&limit=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {}
      },
      "id": "609a09b4-4312-51cd-8ec6-386b9c7ef192",
      "name": "CRM: today",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const overdue = $('CRM: overdue').first().json.tasks || [];\nconst today = $('CRM: today').first().json.tasks || [];\nconst base = $('CRM config').first().json.crm_url;\nconst row = (t) => `<li><b>${t.subject}</b>${t.contact_name ? ` · <a href=\"${base}/#/contacts/${t.contact_id}\">${t.contact_name}</a>` : ''}${t.assigned_name ? ` · ${t.assigned_name}` : ''}</li>`;\nconst section = (title, list) => list.length ? `<h3>${title} (${list.length})</h3><ul>${list.map(row).join('')}</ul>` : '';\nconst html = section('Overdue', overdue) + section('Due today', today) || '<p>No open tasks today. 🎉</p>';\nreturn [{ json: { subject: `Tasks: ${overdue.length} overdue, ${today.length} due today`, html } }];"
      },
      "id": "bca8dd61-60fe-5436-9142-d21ee5e24861",
      "name": "Build digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('CRM config').item.json.crm_url }}/api/emails/send",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ to: $('CRM config').item.json.digest_to, subject: $json.subject, body: $json.html, force: true }) }}"
      },
      "id": "b6845b7b-f155-5ff3-8a6e-e5669c3d4248",
      "name": "CRM: send digest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        0
      ]
    }
  ],
