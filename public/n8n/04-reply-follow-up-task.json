        "method": "POST",
        "url": "={{ $('CRM config').item.json.crm_url }}/api/tasks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ subject: 'Reply from ' + $('CRM event').item.json.body.data.contact.full_name + ': ' + ($('CRM event').item.json.body.data.reply.subject || ''), body: $('CRM event').item.json.body.data.reply.snippet, contact_id: $('CRM event').item.json.body.data.contact.id, assigned_to: $('CRM event').item.json.body.data.contact.owner_id, priority: 'high', due_at: new Date(Date.now() + 7200000).toISOString() }) }}"
      },
