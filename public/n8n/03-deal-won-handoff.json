{
  "name": "CRM · Deal won → onboarding handoff",
  "nodes": [
    {
      "parameters": {
        "content": "## Deal won handoff\nSubscribe this Webhook to `deal.won`. Creates a high-priority onboarding task, sends the customer a welcome email through the CRM (your SMTP), and posts a win to Slack.\n\n**Setup**\n1. Create an API key in the CRM (Integrations → API keys).\n2. In n8n create a **Header Auth** credential named `CRM API key`: Name `Authorization`, Value `Bearer agp_…`.\n3. Select that credential on every *CRM* HTTP Request node.\n4. Set `crm_url` in the **CRM config** node.",
        "width": 560,
        "height": 300
      },
      "id": "4b4cc4a2-05e0-5cb4-86bc-709ac55919f9",
      "name": "Note 0",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -40,
        -330
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "crm-deal-won",
        "options": {}
      },
      "id": "4a22eade-a949-517d-a4b4-72df312b6899",
      "name": "CRM event",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "webhookId": "f36d5b66-31e5-53fc-b372-6c04644cf0a9"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "e7c5e537-46a8-5f7a-bec4-77847e155118",
              "name": "crm_url",
              "value": "http://localhost:3000",
              "type": "string"
            },
            {
              "id": "826cb3b8-864a-551a-a63a-a97141e5a677",
              "name": "slack_webhook_url",
              "value": "https://hooks.slack.com/services/XXX/YYY/ZZZ",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "81444fae-83db-5b44-a0d6-4eb095f8362f",
      "name": "CRM config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "fc1a84aa-20d7-5908-9182-92ea2222368f",
              "leftValue": "={{ $('CRM event').item.json.body.event }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "deal.won"
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "9f35a880-9ec9-51a2-bbc9-29315b46780c",
      "name": "Deal won?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('CRM config').item.json.crm_url }}/api/tasks",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ subject: 'Kick off onboarding: ' + $('CRM event').item.json.body.data.deal.title, contact_id: $('CRM event').item.json.body.data.deal.contact_id, priority: 'high', assigned_to: $('CRM event').item.json.body.data.deal.owner_id, due_at: new Date(Date.now() + 86400000).toISOString() }) }}"
      },
      "id": "a21ef88e-fee7-59a0-8d60-bca6b741d8ce",
      "name": "CRM: onboarding task",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        -20
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "5f01c009-9336-5fee-974f-bb69eaa084cf",
              "leftValue": "={{ $('CRM event').item.json.body.data.deal.contact_id }}",
              "operator": {
                "type": "number",
                "operation": "exists",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "52c79c4a-1f3f-5a10-893b-d49806cdea19",
      "name": "Has contact?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        880,
        -120
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('CRM config').item.json.crm_url }}/api/emails/send",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {},
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ contact_id: $('CRM event').item.json.body.data.deal.contact_id, subject: 'Welcome aboard, {{first_name}}!', body: '<p>Hi {{first_name|there}},</p><p>Thank you for choosing {{my_company}}. Your onboarding lead will be in touch within one business day to schedule the kickoff.</p><p>Best regards,<br>{{sender_name}}</p>' }) }}"
      },
      "id": "b723e794-c1cd-5c5d-82b2-194634cbddfc",
      "name": "CRM: welcome email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        -140
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('CRM config').item.json.slack_webhook_url }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: ':trophy: Deal won: *' + $('CRM event').item.json.body.data.deal.title + '* (' + $('CRM event').item.json.body.data.deal.value + ') by ' + ($('CRM event').item.json.body.data.deal.owner_name || 'the team') }) }}",
        "options": {}
      },
      "id": "938015a8-7655-5d65-8622-f65e6f0092ca",
      "name": "Post win to Slack",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        100
      ],
      "onError": "continueRegularOutput"
    }
  ],
