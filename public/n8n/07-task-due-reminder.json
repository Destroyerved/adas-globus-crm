    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $('CRM config').item.json.telegram_bot_token }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $('CRM config').item.json.telegram_chat_id, text: '⏰ Task due: ' + $('CRM event').item.json.body.data.activity.subject + ($('CRM event').item.json.body.data.activity.contact_name ? ' (' + $('CRM event').item.json.body.data.activity.contact_name + ')' : '') + ($('CRM event').item.json.body.data.activity.assigned_name ? ' → ' + $('CRM event').item.json.body.data.activity.assigned_name : '') }) }}",
        "options": {}
      },
