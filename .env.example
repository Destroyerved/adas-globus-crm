# Copy to .env and fill in. Everything except APP_SECRET and BASE_URL can also be set in the CRM's UI.

# ---------- CRM ----------
PORT=3000
# Public address of the CRM. Tracking pixels, click links and unsubscribe links in emails point here.
# Use your real HTTPS address in production, e.g. https://crm.adasglobuspro.com
BASE_URL=http://localhost:3000
# Long random string. Encrypts stored passwords/API keys and signs links. Keep it safe; changing it means re-entering credentials.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=
# Set both to true when running behind HTTPS (Caddy, Nginx, Cloudflare)
TRUST_PROXY=false
SECURE_COOKIES=false
COMPANY_NAME=Adas Globus Pro
CURRENCY=USD
# Time zone for business-hours sending and n8n schedules, e.g. Asia/Kolkata, Asia/Dubai, Europe/London
TZ=UTC

# ---------- Optional: preconfigure integrations ----------
APOLLO_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=
IMAP_ENABLED=false
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASS=
# Log emails instead of sending them (testing)
MAIL_DRY_RUN=false
# One-click n8n setup (Integrations → n8n & webhooks). API key from n8n: Settings → n8n API.
# Outside Docker, N8N_URL is e.g. http://localhost:5678 and CRM_URL_FOR_N8N can stay empty (BASE_URL is used).
N8N_API_KEY=
N8N_URL=
CRM_URL_FOR_N8N=
# Browser address of the n8n editor, for "Open in n8n" links and public form URLs
N8N_EDITOR_URL=

# ---------- n8n (docker-compose) ----------
# Random string; n8n encrypts its saved credentials with it
N8N_ENCRYPTION_KEY=
N8N_HOST=localhost
N8N_PROTOCOL=http
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_SECURE_COOKIE=false

# ---------- HTTPS via Caddy: docker compose --profile https up -d ----------
CRM_DOMAIN=crm.example.com
N8N_DOMAIN=n8n.example.com
